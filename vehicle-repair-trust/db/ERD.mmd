    GARAGES ||--o{ REPAIR_CASES : hosts
    MECHANICS ||--o{ REPAIR_CASES : handles

    REPAIR_CASES ||--o{ MEDIA_ASSETS : contains
    REPAIR_CASES ||--o{ MECHANIC_CLAIMS : has
    REPAIR_CASES ||--o{ REPAIR_PROPOSALS : has
