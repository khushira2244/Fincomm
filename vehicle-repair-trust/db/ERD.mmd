    REPAIR_CASES ||--o{ FITTED_PARTS : has
    REPAIR_CASES ||--o{ EVIDENCE_REQUESTS : has
    REPAIR_CASES ||--o{ AGENT_RUNS : triggers
    REPAIR_CASES ||--o{ PRE_SERVICE_REASONING_RESULTS : has
    REPAIR_CASES ||--o{ FINAL_REPAIR_REPORTS : has
